# Server
PORT=3000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/tradelink

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email — Resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=TradeLink <noreply@yourdomain.com>

# Stripe Connect
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_CONNECT_CLIENT_ID=your_stripe_connect_client_id
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Ratings
# How long after submitting a rating it may still be changed. 0 = immutable.
GRADE_EDIT_WINDOW_HOURS=24
# Comma-separated hosts accepted for review photo URLs. https only.
GRADE_PHOTO_HOSTS=res.cloudinary.com

# Client
CLIENT_URL=http://localhost:5173
